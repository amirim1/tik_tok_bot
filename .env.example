# Telegram Bot Token (обязательно)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Файл логов
LOG_FILE=bot.log

# Директория для временных видеофайлов
TEMP_DIR=temp_videos

# Максимальный размер видео в MB
MAX_FILE_SIZE_MB=50

# Лимит запросов от одного пользователя
RATE_LIMIT_CALLS=5
# Окно лимита (секунд)
RATE_LIMIT_WINDOW=60

# Файл для хранения данных rate limit (persistence между перезапусками)
RATE_LIMIT_FILE=rate_limit.json

# Начальные пользователи whitelist через запятую. Используется только при первом запуске.
ALLOWED_USERS=

# Telegram ID администратора. Не добавляйте реальный ID в Git: задайте его только в .env на сервере.
ADMIN_USER_ID=

# Файл с текущим whitelist (изменяется командой /access и не коммитится).
ALLOWED_USERS_FILE=allowed_users.json

# Таймаут загрузки видео (сек)
DOWNLOAD_TIMEOUT=30

# Количество повторов при ошибке API
MAX_DOWNLOAD_RETRIES=2
